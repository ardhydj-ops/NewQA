# Salin file ini jadi `.env.local` dan isi nilai aslinya.
# `.env.local` di-ignore git — jangan di-commit.

# Supabase project URL — Settings → API → Project URL
# Aman untuk di-expose ke browser → pakai prefix NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co

# Publishable API key — Settings → API → Publishable keys
# Format baru Supabase: dimulai dengan `sb_publishable_...`
# (setara `anon` key di versi lama)
# Aman di-expose ke browser; akses dibatasi oleh RLS policy di DB.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...your-publishable-key...
